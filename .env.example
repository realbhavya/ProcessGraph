APP_NAME=ProcessGraph Sentinel
APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3001
APP_SECRET=replace-with-a-random-local-secret

FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=local-falkordb-password
FALKORDB_GRAPH_PREFIX=processgraph
FALKORDB_BROWSER_PORT=3000

LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=

MAX_TRAVERSAL_DEPTH=4
AGENT_TIMEOUT_SECONDS=30
MEMORY_PROMOTION_THRESHOLD=0.80
VITE_API_BASE_URL=http://localhost:8000

REAL_DATA_MODE=rieth-tep-2017
TIMESERIES_HOST=timeseries
TIMESERIES_PORT=5432
TIMESERIES_DB=processgraph
TIMESERIES_USER=processgraph
TIMESERIES_PASSWORD=processgraph-local
TIMESERIES_DSN=postgresql://processgraph:processgraph-local@timeseries:5432/processgraph

OPCUA_ENDPOINT=opc.tcp://opcua-replay:4840/processgraph/tep/
REPLAY_DATASET_ID=rieth-tep-2017
REPLAY_SPLIT=faulty_testing
REPLAY_FAULT_NUMBER=1
REPLAY_SIMULATION_RUN=1
REPLAY_SPEED=180
OPCUA_HOLD_OPEN=true
